<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MonadicTypes.AspNetCore.OpenApi\MonadicTypes.AspNetCore.OpenApi.csproj" />
  </ItemGroup>
  <!-- ProjectReference restore reintroduces the transitive Microsoft analyzer; the packed package excludes it. -->
  <Target Name="MirrorPackagedOpenApiAnalyzerBoundary" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer
        Remove="@(Analyzer)"
        Condition="'%(Analyzer.Filename)%(Analyzer.Extension)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators.dll'" />
    </ItemGroup>
  </Target>
</Project>
