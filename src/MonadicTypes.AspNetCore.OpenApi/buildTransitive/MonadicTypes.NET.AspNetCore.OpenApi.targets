<Project>
  <Target Name="EnforceMonadicTypesOpenApiReflectionBoundary" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ExplicitMicrosoftOpenApiReference
        Include="@(PackageReference)"
        Condition="'%(PackageReference.Identity)' == 'Microsoft.AspNetCore.OpenApi'" />
      <Analyzer
        Remove="@(Analyzer)"
        Condition="'@(_ExplicitMicrosoftOpenApiReference)' == '' AND '%(Analyzer.Filename)%(Analyzer.Extension)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators.dll'" />
    </ItemGroup>
  </Target>
</Project>
