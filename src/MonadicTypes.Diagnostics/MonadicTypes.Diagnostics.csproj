<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MonadicTypes.NET.Diagnostics</PackageId>
    <Title>MonadicTypes.NET Diagnostics</Title>
    <Description>Optional Activity and Meter instrumentation for structured MonadicTypes.NET errors.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonadicTypes.Errors\MonadicTypes.Errors.csproj" />
  </ItemGroup>
</Project>
