root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning

# Modern syntax is enforced only where the compiler preserves the intended type.
csharp_style_prefer_primary_constructors = true:warning
dotnet_style_prefer_collection_expression = when_types_exactly_match:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_utf8_string_literals = true:suggestion

# Pattern matching remains preferred without forcing switch expressions in hot paths.
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion

# Immutability and capture avoidance are correctness and allocation rules here.
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_static_anonymous_function = true:warning
csharp_style_prefer_method_group_conversion = true:suggestion

dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
csharp_style_throw_expression = true:warning
csharp_prefer_simple_default_expression = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_deconstructed_variable_declaration = true:warning

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.interfaces_prefixed.severity = warning
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = interface_style
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

dotnet_naming_rule.type_parameters_prefixed.severity = warning
dotnet_naming_rule.type_parameters_prefixed.symbols = type_parameters
dotnet_naming_rule.type_parameters_prefixed.style = type_parameter_style
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.type_parameter_style.required_prefix = T
dotnet_naming_style.type_parameter_style.capitalization = pascal_case

dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = private
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_fields_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_underscored.severity = warning
dotnet_naming_rule.private_fields_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_underscored.style = private_field_style
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.private_field_style.required_prefix = _
dotnet_naming_style.private_field_style.capitalization = camel_case

[*.{props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Option and generic static factories are intentional C# FP API shapes.
[src/MonadicTypes/Option.cs]
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1716.severity = none

[src/MonadicTypes/Result.cs]
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1715.severity = none
dotnet_diagnostic.IDE1006.severity = none

# The non-generic Result factory shares its base name with Result<T, E>.
[src/MonadicTypes/ResultFactory.cs]
dotnet_diagnostic.CA1715.severity = none
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.MA0048.severity = none

# Mutable callable structs must not be copied through a readonly wrapper field.
[src/MonadicTypes/ValueFunction.cs]
dotnet_diagnostic.IDE0044.severity = none
dotnet_diagnostic.IDE0290.severity = none

# Error is the intentional domain type name; ValidationIssue also owns its enum.
[src/MonadicTypes.Errors/Error.cs]
dotnet_diagnostic.CA1716.severity = none

[src/MonadicTypes.Errors/ValidationIssue.cs]
dotnet_diagnostic.MA0048.severity = none

# Behavior_Expectation test names and co-located fixtures improve test diagnostics.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0048.severity = none

# Async pipeline tests consume each ValueTask once through fluent extensions.
[tests/MonadicTypes.Async.Tests/AsyncResultTests.cs]
dotnet_diagnostic.CA2012.severity = none

# This test verifies Error's parameterless IFormattable fallback explicitly.
[tests/MonadicTypes.Errors.Tests/ErrorTests.cs]
dotnet_diagnostic.MA0011.severity = none

# These benchmarks intentionally consume known-completed ValueTasks synchronously.
[benchmarks/MonadicTypes.Composition.Benchmarks/CompositionBenchmarks.cs]
dotnet_diagnostic.CA2012.severity = none
dotnet_diagnostic.MA0048.severity = none

# BDN owns lifecycle through GlobalCleanup; legacy factories are the control API.
[benchmarks/MonadicTypes.Benchmarks/PrimitiveBenchmarks.cs]
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1001.severity = none

# This test intentionally verifies the public metadata interface contract.
[tests/MonadicTypes.AspNetCore.Tests/ProducesErrorMetadataTests.cs]
dotnet_diagnostic.CA1859.severity = none

# Top-level statements require their generated callable host in the global namespace.
[tests/MonadicTypes.AotSmoke/Program.cs]
dotnet_diagnostic.CA1050.severity = none
dotnet_diagnostic.CA2012.severity = none
dotnet_diagnostic.MA0047.severity = none
